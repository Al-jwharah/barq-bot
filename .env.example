# Public origin — the only host used for links, webhook, OG, sitemap
# Keep the working subdomain until apex SSL is verified.
BARQ_PUBLIC_ORIGIN=https://barq.abdulrhman.ai

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BARQ_BOT_USERNAME=barq_ibot

# xAI / Grok
XAI_API_KEY=
# Default model id (internal, never show to users): grok-4.5 — UI brand «برق AI» only.

# Admin
# Production MUST set BARQ_ADMIN_PIN_HASH (64-char scrypt hex). Do not use plaintext PIN in prod.
# node -e "const {scryptSync}=require('crypto'); console.log(scryptSync(process.argv[1],'barq-admin-pin-v1',32,{N:16384,r:8,p:1}).toString('hex'))" YOUR_PIN
BARQ_ADMIN_PIN_HASH=
# Local-dev fallback only. Never log this value. Production must use BARQ_ADMIN_PIN_HASH.
BARQ_ADMIN_PIN=
BARQ_OWNER_TG_ID=8471762251
BARQ_OWNER_IDS=8471762251,5554780316
BARQ_JOB_SECRET=
# Vercel cron Authorization Bearer. Prefer same value as BARQ_JOB_SECRET.
# /api/keep accepts Bearer CRON_SECRET or BARQ_JOB_SECRET.
CRON_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# Flags
# BARQ_MAINTENANCE=on blocks downloads; leave off in production when serving users
BARQ_MAINTENANCE=on
BARQ_TEMP_FREE=on
# Subscriptions product: UI/plans/gating ON; PAYMENT DEFERRED (no Stars checkout / charging).
# BARQ_SUBSCRIPTIONS_UI=on → pricing page + Telegram deep-links + plan gates visible.
# BARQ_SUBSCRIPTIONS_LIVE=off → do NOT process payments / invoices / pre_checkout.
BARQ_SUBSCRIPTIONS_UI=on
BARQ_SUBSCRIPTIONS_LIVE=off
# Short-link CTAs (رابط مختصر). Keep off while Vercel Blob store is suspended; tgfile fallback still serves clip links.
BARQ_SHORT_LINKS_UI=off
# Squad B gates — keep OFF until Squad C reports 48h no new failures. Never enable with BARQ_SUBSCRIPTIONS_LIVE.
BARQ_REFERRALS_LIVE=off
BARQ_LEADERBOARD_LIVE=off
BARQ_AI_DAILY=10
# Free tier: 10 downloads per Riyadh day (BARQ_FREE_DOWNLOADS + BARQ_DAILY_CAP must match).
BARQ_FREE_DOWNLOADS=10
BARQ_MONTHLY_CAP=30
BARQ_MONTHLY_CAP_ON=on
BARQ_DAILY_CAP=10
BARQ_DAILY_CAP_ON=on
BARQ_VAULT_ARCHIVE_ENABLED=
BARQ_AI_ENABLED=
BARQ_COFFEE_ENABLED=
BARQ_WATERMARK_ENABLED=
BARQ_LAUNCH_MODE=
# Soft public beta seat gate (code default 500). Raise in Vercel dashboard for wider beta — do not commit secrets.
BARQ_LAUNCH_MAX=

# Persistence (Vercel)
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
# Second DB for restore dry-run ONLY. Must differ from DATABASE_URL.
# Never point this at production. Used by: node scripts/restore-dry-run.mjs
RESTORE_DATABASE_URL=
SENTRY_DSN=
# Owner: fill SENTRY_DSN on Vercel when ready (never invent a DSN in code/docs).
# When set, sentry.server.ts posts errors via Sentry store API.

# Ops: alert owners when last-hour download_jobs fail rate exceeds this fraction (0–1).
# Default 0.35 (35%). Also accepts percent form e.g. 35.
BARQ_FAIL_RATE_ALERT=

# Limits & retention
FILE_RETENTION_DAYS=
TEMP_FILE_RETENTION_HOURS=
LOG_RETENTION_DAYS=
DOWNLOAD_TIMEOUT_MS=
MAX_DOWNLOAD_SIZE_MB=
MAX_CONCURRENT_JOBS=
# Per-/api/jobs drain budget (default 5, max 8). Lower under Neon pool storms.
JOBS_DRAIN_BUDGET=
# Neon pg pool max per isolate (default 4, max 8).
BARQ_PG_POOL_MAX=
AI_MAX_MESSAGE_LENGTH=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
ADMIN_MAX_LOGIN_ATTEMPTS=
ADMIN_LOCK_MINUTES=

# Timezone & logging
BARQ_TIMEZONE=Asia/Riyadh
LOG_LEVEL=info

# Telegram local API / cloud upload
TELEGRAM_CLOUD_MAX_MB=50
USE_LOCAL_TELEGRAM_API=false

# Cleanup & retention
CLEANUP_ENABLED=true
BARQ_VAULT_RETENTION_DAYS=7
# Local: false (PGLite). Production: true only after DATABASE_URL is proven.
BARQ_REQUIRE_POSTGRES=false

# --- Always-on worker (Architecture B) — proposals for owner; agents do not set deploy secrets ---
# BARQ_EXTERNAL_WORKER=off
# WORKER_WAKE_URL=
# BARQ_WORKER_DRY_RUN=off
# WORKER_IDLE_MS=1500
# Suggested on worker host (not auto-set on Vercel): DOWNLOAD_TIMEOUT_MS=270000

# --- AI layer (feature/ai-layer) — propose names only; do not set secrets here ---
# Optional Whisper / transcription before «لخّصه» (default off)
# BARQ_AI_TRANSCRIBE=off
# BARQ_WHISPER_URL=
# BARQ_WHISPER_API_KEY=
# Auto-subtitles opt-in UI (scaffold). Burn-in stays off until worker capacity exists.
# BARQ_AI_SUBTITLES=on
# BARQ_AI_SUBTITLES_BURN=off

# --- Website redesign (D2–D5) proposed / feature flags ---
# Weekly public leaderboard (default off). Prefer real Postgres query when on.
BARQ_LEADERBOARD_LIVE=off
# Telegram Login Widget for /library (default off). Requires BotFather /setdomain.
BARQ_TELEGRAM_LOGIN_ENABLED=off
BARQ_TELEGRAM_LOGIN_DOMAIN=
# Optional auth_date skew for Login Widget (seconds)
BARQ_TELEGRAM_LOGIN_MAX_AGE_SEC=86400
# xAI key for homepage AI playground (runtime). Leave empty => clear disabled UI.
# XAI_API_KEY=
# Default model id (internal, never show to users): grok-4.5 — UI brand «برق AI» only.

