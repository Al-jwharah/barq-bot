# Public origin — the only host used for links, webhook, OG, sitemap
# Keep the working subdomain until apex SSL is verified.
BARQ_PUBLIC_ORIGIN=https://barq.abdulrhman.ai

# Telegram
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
BARQ_BOT_USERNAME=barq_ibot

# xAI / Grok
XAI_API_KEY=

# Admin
# Production MUST set BARQ_ADMIN_PIN_HASH (64-char scrypt hex). Do not use plaintext PIN in prod.
# node -e "const {scryptSync}=require('crypto'); console.log(scryptSync(process.argv[1],'barq-admin-pin-v1',32,{N:16384,r:8,p:1}).toString('hex'))" YOUR_PIN
BARQ_ADMIN_PIN_HASH=
# Local-dev fallback only. Never log this value. Production must use BARQ_ADMIN_PIN_HASH.
BARQ_ADMIN_PIN=
BARQ_OWNER_TG_ID=8471762251
BARQ_OWNER_IDS=8471762251,5554780316
BARQ_JOB_SECRET=
# Vercel cron Authorization Bearer. Prefer same value as BARQ_JOB_SECRET.
# /api/keep accepts Bearer CRON_SECRET or BARQ_JOB_SECRET.
CRON_SECRET=
SESSION_SECRET=
ENCRYPTION_KEY=

# Flags
# BARQ_MAINTENANCE=on blocks downloads; leave off in production when serving users
BARQ_MAINTENANCE=on
BARQ_TEMP_FREE=on
BARQ_SUBSCRIPTIONS_LIVE=off
BARQ_AI_DAILY=10
BARQ_FREE_DOWNLOADS=10
BARQ_MONTHLY_CAP=30
BARQ_MONTHLY_CAP_ON=on
BARQ_DAILY_CAP=
BARQ_DAILY_CAP_ON=
BARQ_VAULT_ARCHIVE_ENABLED=
BARQ_AI_ENABLED=
BARQ_COFFEE_ENABLED=
BARQ_WATERMARK_ENABLED=
BARQ_LAUNCH_MODE=
# Soft public beta seat gate (code default 500). Raise in Vercel dashboard for wider beta — do not commit secrets.
BARQ_LAUNCH_MAX=

# Persistence (Vercel)
BLOB_READ_WRITE_TOKEN=
DATABASE_URL=
# Second DB for restore dry-run ONLY. Must differ from DATABASE_URL.
# Never point this at production. Used by: node scripts/restore-dry-run.mjs
RESTORE_DATABASE_URL=
SENTRY_DSN=

# Limits & retention
FILE_RETENTION_DAYS=
TEMP_FILE_RETENTION_HOURS=
LOG_RETENTION_DAYS=
DOWNLOAD_TIMEOUT_MS=
MAX_DOWNLOAD_SIZE_MB=
MAX_CONCURRENT_JOBS=
# Per-/api/jobs drain budget (default 5, max 8). Lower under Neon pool storms.
JOBS_DRAIN_BUDGET=
# Neon pg pool max per isolate (default 4, max 8).
BARQ_PG_POOL_MAX=
AI_MAX_MESSAGE_LENGTH=
AI_MAX_OUTPUT_TOKENS=
AI_TIMEOUT_MS=
ADMIN_MAX_LOGIN_ATTEMPTS=
ADMIN_LOCK_MINUTES=

# Timezone & logging
BARQ_TIMEZONE=Asia/Riyadh
LOG_LEVEL=info

# Telegram local API / cloud upload
TELEGRAM_CLOUD_MAX_MB=50
USE_LOCAL_TELEGRAM_API=false

# Cleanup & retention
CLEANUP_ENABLED=true
BARQ_VAULT_RETENTION_DAYS=7
# Local: false (PGLite). Production: true only after DATABASE_URL is proven.
BARQ_REQUIRE_POSTGRES=false

# --- AI layer (feature/ai-layer) — propose names only; do not set secrets here ---
# Optional Whisper / transcription before «لخّصه» (default off)
# BARQ_AI_TRANSCRIBE=off
# BARQ_WHISPER_URL=
# BARQ_WHISPER_API_KEY=
# Auto-subtitles opt-in UI (scaffold). Burn-in stays off until worker capacity exists.
# BARQ_AI_SUBTITLES=on
# BARQ_AI_SUBTITLES_BURN=off

